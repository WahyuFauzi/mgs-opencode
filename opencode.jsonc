{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "raiden",
  "lsp": {
    "jdtls": {
      "command": ["/Users/user/.config/opencode/bin/jdtls-opencode"],
      "extensions": [".java"],
      "initialization": {
        "java": {
          "configuration": {
            "runtimes": [
              {
                "name": "JavaSE-21",
                "path": "/Users/user/.config/jdk/jdk-21.0.12+8/Contents/Home",
                "default": true
              }
            ]
          },
          "import": {
            "gradle": {
              "java": {
                "home": "/Users/user/.config/jdk/jdk-21.0.12+8/Contents/Home"
              }
            }
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    // Disabled by default to cut per-turn token overhead (9 tool schemas).
    // To research, set "enabled": true (or per-agent: permission.brave-search_* = allow).
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "enabled": false,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_SEARCH_API_KEY}"
      }
    },
    // Largest single token item: ~30 verbose tool schemas + ~3K-word instructions block.
    // Re-enable only when doing code-graph work: set "enabled": true.
    "CodeGraphContext": {
      "type": "local",
      "command": ["codegraphcontext", "mcp", "start"],
      "enabled": false
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  }
}
